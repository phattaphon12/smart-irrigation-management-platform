# Ambient Weather API (pipeline B — weather station / ETo, ETc)
# Docs: https://ambientweather.docs.apiary.io/
# ขอ key ได้จาก https://ambientweather.net/account -> API Keys
VITE_AMBIENT_API_KEY=
VITE_AMBIENT_APPLICATION_KEY=
VITE_AMBIENT_STATION_MAC=10:91:A8:0D:D3:DC

# ตั้งเป็น "true" เพื่อดึงข้อมูลสดจาก Ambient Weather API แทนข้อมูล mock
# หมายเหตุด้านความปลอดภัย: การเรียก API ตรงจาก browser จะ expose API key ให้ผู้ใช้เห็นได้
# (ดูรายละเอียดใน README.md หัวข้อ "การเชื่อมต่อ Ambient Weather API") แนะนำให้ทำ backend
# proxy เก็บ key ไว้ฝั่ง server ก่อนใช้งานจริงใน production
VITE_USE_LIVE_WEATHER=false

# Pipeline A (โหนดเซนเซอร์ความชื้นดิน ESP32-H2) ยังไม่มี API กลางตามเอกสารอ้างอิง
# เมื่อทีม backend มี endpoint แล้ว ให้ตั้งค่านี้และแก้ src/lib/api/soilNodeClient.js
VITE_SOIL_API_BASE_URL=
