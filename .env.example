# Used by docker-compose.yml (docker compose auto-loads a .env file from the
# same directory) to fill in service credentials. Copy this to .env on the
# deploy server and set real values there — .env is gitignored, never commit
# real credentials.

# Postgres superuser — the `db` container's own bootstrap admin account
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Lower-privilege role the backend actually connects with day to day
APP_DB_USER=
APP_DB_PASSWORD=

# Ambient Weather station credentials (also editable later via the app's
# Settings page once it's running — these are just the initial values)
AMBIENT_API_KEY=
AMBIENT_APPLICATION_KEY=
AMBIENT_STATION_MAC=
