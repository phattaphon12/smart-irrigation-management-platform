# URL ของ sugarcane-backend (proxy ไป Ambient Weather — apiKey/applicationKey/mac
# ตั้งค่าที่ backend เท่านั้น ดู sugarcane-backend/.env.example และหน้า Settings ในแอป)
VITE_BACKEND_URL=http://localhost:4000

# ตั้งเป็น "true" เพื่อดึงข้อมูลสดจาก Ambient Weather API (ผ่าน backend) แทนข้อมูล mock
VITE_USE_LIVE_WEATHER=false

# Pipeline A (โหนดเซนเซอร์ความชื้นดิน ESP32-H2) ยังไม่มี API กลางตามเอกสารอ้างอิง
# เมื่อทีม backend มี endpoint แล้ว ให้ตั้งค่านี้และแก้ src/lib/api/soilNodeClient.js
VITE_SOIL_API_BASE_URL=
