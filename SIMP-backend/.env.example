PORT=4000

# Allowed origin for the frontend calling this API (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Ambient Weather API — kept server-side only, never sent to the browser
AMBIENT_API_KEY=
AMBIENT_APPLICATION_KEY=
AMBIENT_STATION_MAC=

# simp-database (Postgres, docker-compose) — soil sensor nodes (nodes/node_log/log tables)
PGHOST=localhost
PGPORT=5432
PGUSER=simpadmin
PGPASSWORD=simppassword
PGDATABASE=simp_database
